# Pi model selection. Example providers and model IDs depend on configured pi-ai credentials.
PI_PROVIDER=openai
PI_MODEL=

# Set the credential required by the selected provider. Never commit real values.
OPENAI_API_KEY=

# Planet Data API credential. Keep the real value only in .env; it is read by
# the Fastify backend and must never be exposed to the browser.
PL_API_KEY=

# PostGIS field storage used by the API in normal development and production.
DATABASE_URL=postgresql://chernozem:chernozem_local_only@localhost:5432/chernozem

# Codex harness powers ordinary Agent conversation only. Agricultural feature
# workflows remain deterministic and do not depend on model availability.
CODEX_MODEL=gpt-5.6-terra
CODEX_BASE_URL=
# Optional runtime isolation overrides. Defaults live under runtime/codex/.
CODEX_HOME=
# Optional empty workspace outside the repository; defaults to a dedicated system temporary directory.
CODEX_WORKING_DIRECTORY=
CODEX_PATH=
# Never commit real credentials.
OPENAI_API_KEY=
# Optional upstream proxy for the model subprocess; keep task-local MCP off the proxy.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# PostGIS field storage used by the API in normal development and production.
DATABASE_URL=postgresql://chernozem:chernozem_local_only@localhost:5432/chernozem

# Public catalogue discovery works without credentials. Native GLO-30 OData
# downloads exchange the account credentials for a short-lived cdse-public token.
CDSE_USERNAME=
CDSE_PASSWORD=
# Sentinel-1/2 field-sized Process API downloads require an OAuth client created
# in the CDSE Sentinel Hub dashboard. Do not expose these credentials to the web app.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Personal Access Token from https://cds.climate.copernicus.eu/profile
CDS_API_KEY=
# Python runtime used by weather and geospatial acquisition workers.
PYTHON_EXECUTABLE=python

# Read-only agronomy MCP. Local extractive search needs no model/embedding key.
KNOWLEDGE_MCP_ENABLED=false
KNOWLEDGE_SEARCH_ENGINE=local
# Override only when the MCP server is not launched through the workspace pnpm command.
KNOWLEDGE_MCP_COMMAND=
KNOWLEDGE_MCP_ARGS_JSON=
# Use a Python 3.10-3.12 environment with graphrag==3.1.1 installed.
GRAPHRAG_PYTHON=
GRAPHRAG_ROOT=
GRAPHRAG_DATA_DIR=
# Optional GraphRAG override. When empty, the runtime reuses OPENAI_BASE_URL
# and OPENAI_API_KEY.
GRAPHRAG_API_BASE=
GRAPHRAG_API_KEY=
